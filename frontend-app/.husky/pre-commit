#!/usr/bin/env sh
set -e

# Single-pass gate design (Option A):
# Local pre-commit runs ONLY ultra-fast secret scanning (<1s) to stop credentials before `git push`.
# oxlint, eslint, commitlint, and vitest related run ONCE authoritatively in GHES PR Gate (pr-gate.yml).
if command -v ggshield >/dev/null 2>&1; then
  ggshield secret scan pre-commit
else
  echo "⚠️  ggshield not installed locally (still enforced in GHES PR Gate)"
fi
