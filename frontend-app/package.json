{
  "name": "react-copilot-jenkins-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint:oxlint": "oxlint src",
    "lint:eslint": "eslint src",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "test": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "prepare": "husky || true",
    "jenkins:status": "node ../frontend-cicd/scripts/jenkins-inspect.mjs status",
    "jenkins:log": "node ../frontend-cicd/scripts/jenkins-inspect.mjs log"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "oxlint": "^0.15.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
